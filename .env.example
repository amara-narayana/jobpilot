# JobPilot Configuration Example
# Copy to .env and adjust variables as necessary

# Server
PORT=8080
APP_ENV=development

# MySQL 8.x Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jobpilot_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=jobpilot
MYSQL_POOL_SIZE=10

# Security
SESSION_SECRET=change_this_to_a_long_random_secret_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email SMTP (Leave empty for development logger adapter)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JobPilot <noreply@jobpilot.io>
